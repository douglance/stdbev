# Build output. No trailing slash: these are symlinks into a local build cache on this
# machine, and a trailing slash matches only real directories -- so `/target/` silently
# let the symlink through, staging a path that means nothing on anyone else's machine.
/target
/crates/*/target
crates/stdbev-stdb/target

# Generated corpora: reproducible byte for byte with `cargo xtask data`,
# and 31 MB that would otherwise bloat every clone.
/data/generated/

# Training runs: checkpoints and history, regenerated by `cargo xtask train`.
/runs/

# Editor / OS noise
.DS_Store
*.swp
